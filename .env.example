# =========================================================================
# Production env for the homelab Docker stack.
# Copy to .env.production and fill secrets. Used both as the backend env_file
# AND for docker compose variable substitution:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
# =========================================================================

# --- App ---
APP_NAME="Politics Platform"
APP_ENV=production
APP_KEY=                                    # php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.tudominio.com
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

FRONTEND_URL=https://localhost:3000
BACKEND_URL=https://localhost:8000

# Surface logs in `docker logs` (no local storage volume is mounted)
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database (dedicated postgres container, internal only) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=politics_platform
DB_USERNAME=politics
DB_PASSWORD=__SET_A_STRONG_PASSWORD__                   # REQUIRED — set a strong password

# --- Redis (internal) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# --- JWT ---

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=email-smtp.us-east-2.amazonaws.com
MAIL_PORT=587

MAIL_USERNAME=__SES_SMTP_USERNAME__
MAIL_PASSWORD=__SES_SMTP_PASSWORD__
MAIL_FROM_ADDRESS="noreply@appcore.com.co"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=politics-platform-default
AWS_ENDPOINT=https://s3.us-east-1.wasabisys.com
AWS_URL=https://s3.us-east-1.wasabisys.com
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# JWT Configuration
JWT_SECRET=                    # generate: php artisan jwt:secret --show
JWT_TTL=120
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=30

# Superadmin credentials (will be seeded)
SUPERADMIN_NAME="Super Administrator"
SUPERADMIN_EMAIL=admin@politics-platform.com
SUPERADMIN_PASSWORD=__SET_A_STRONG_PASSWORD__

# Admin contact email for tenant support
ADMIN_EMAIL=admin@appcore.com.co

# SMS Provider (twilio, plivo, log)
SMS_PROVIDER=log
SMS_TWILIO_SID=
SMS_TWILIO_TOKEN=
SMS_TWILIO_FROM=

# Campaign Configuration
CAMPAIGN_BATCH_SIZE=100
CAMPAIGN_RATE_LIMIT_PER_MINUTE=60

# QR Code Configuration
QR_CODE_SIZE=300
QR_CODE_MARGIN=2

N8N_WEBHOOK_URL=https://n8n.appcoresas.cloud/webhook/notifications/emails
N8N_WHATSAPP_WEBHOOK_URL=https://n8n.appcoresas.cloud/webhook/notifications/whatsapp
N8N_AUTH_TOKEN=__N8N_AUTH_TOKEN__

# Servicio de Registraduría (Spec 0091)
# -------------------------------------
# El scraping vive en `platform-politics-registraduria` (FastAPI). Laravel lo
# llama DE SALIDA, en cola, cuando un votante nace sin puesto de votación.
# Sustituye a los webhooks de n8n de la Spec 0030, que ya no existen.
#
# Levantar el servicio (en su repo, con el venv activo):
#
#   uvicorn app:app --host 127.0.0.1 --port 8100
#
# El token es el mismo `API_TOKEN` del `.env` de ese servicio: se manda como
# `Authorization: Bearer`. Sin él, el servicio responde 401 a todo.
#
# Dejar REGISTRADURIA_SERVICE_URL vacía APAGA la integración: no se encola nada
# y nadie sale a la red. Es el estado por defecto y el de las pruebas.
REGISTRADURIA_SERVICE_URL=http://127.0.0.1:8100
REGISTRADURIA_SERVICE_TOKEN=__REGISTRADURIA_SERVICE_TOKEN__
# Techo de espera (s). Cubre 120 s de intento gratis + 180 s del pago, con margen.
REGISTRADURIA_SERVICE_TIMEOUT=320

SENTRY_LARAVEL_DSN=__SENTRY_DSN__
SENTRY_SEND_DEFAULT_PII=true
SENTRY_TRACES_SAMPLE_RATE=1.0

MERCADOPAGO_PUBLIC_KEY=__MERCADOPAGO_PUBLIC_KEY__
MERCADOPAGO_ACCESS_TOKEN=__MERCADOPAGO_ACCESS_TOKEN__

# --- Geocodificación (Spec 0055) -------------------------------------------
# Nominatim (OpenStreetMap) no pide clave, pero sí un User-Agent identificable
# con un correo de contacto: es su política de uso. Para auto-hospedarlo, apunta
# GEOCODING_NOMINATIM_URL a tu instancia.
GEOCODING_PROVIDER=nominatim
GEOCODING_NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=SuiteElectoral/1.0
GEOCODING_CONTACT_EMAIL=
GEOCODING_CACHE_TTL=2592000
GEOCODING_TIMEOUT=8

# Binarios de PostgreSQL para leads:backup / leads:restore (Spec 0059).
# En Windows no suelen estar en el PATH.
PG_DUMP_PATH='C:/Program Files/PostgreSQL/16/bin/pg_dump.exe'
PSQL_PATH='C:/Program Files/PostgreSQL/16/bin/psql.exe'
