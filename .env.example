# =========================================================================
# Production env for the homelab Docker stack.
# Copy to .env.production and fill secrets. Used both as the backend env_file
# AND for docker compose variable substitution:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
# =========================================================================

# --- App ---
APP_NAME="Politics Platform"
APP_ENV=production
APP_KEY=                       # generate: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://api.tudominio.com
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# Surface logs in `docker logs` (no local storage volume is mounted)
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database (dedicated postgres container, internal only) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=politics_platform
DB_USERNAME=politics
DB_PASSWORD=postgres2026!                   # REQUIRED — set a strong password

# --- Redis (internal) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# --- JWT ---
JWT_SECRET= uIfDXGRiDpfnqgMYXKRD1vUIr0oiKeoUfYRNwCG2ZIW9Luf8UQ3MTO8cHgs35GQZ                    # generate: php artisan jwt:secret --show
JWT_TTL=60
JWT_REFRESH_TTL=20160

# --- Superadmin (seeded idempotently on boot — your login) ---
SUPERADMIN_NAME="Super Administrator"
SUPERADMIN_EMAIL=tu-gildardo.patino.trillos@gmail.com
SUPERADMIN_PASSWORD=Gscclan0909..           # REQUIRED — set a strong password
ADMIN_EMAIL=gildardo.patino.trillos@gmail.com

# --- SMS (default: log) ---
SMS_PROVIDER=log

# --- Mail (transactional via n8n / SMTP) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@tudominio.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Wasabi / S3 (tenant file storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- External integrations (fill as needed) ---
# MercadoPago, Evolution API (WhatsApp), n8n webhooks, etc.

# =========================================================================
# Compose-only variables (frontend build + ports)
# =========================================================================
# Public API URL baked into the frontend at build time:
VITE_API_BASE_URL=https://api.tudominio.com/api/v1
